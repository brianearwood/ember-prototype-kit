{
  "name": "ember-prototype-kit-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable tooling for Ember design-system prototypes",
  "repository": "https://github.com/brianearwood/ember-prototype-kit",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "release": "pnpm --filter ember-prototype-inspector build && changeset publish",
    "start": "pnpm --filter test-app start",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7"
  },
  "engines": {
    "node": ">= 20.19"
  }
}
