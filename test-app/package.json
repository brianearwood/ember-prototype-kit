{
  "name": "test-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Demo and test app for ember-prototype-inspector",
  "repository": "",
  "license": "MIT",
  "author": "",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "pnpm test:ember",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@ember/app-tsconfig": "^1.0.3",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.0",
    "@ember/test-helpers": "^5.8.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.28",
    "@embroider/config-meta-loader": "^1.0.1",
    "@embroider/core": "^4.6.10",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.8.1",
    "@eslint/js": "^9.39.5",
    "@glimmer/component": "^2.2.1",
    "@glint/ember-tsc": "^1.14.4",
    "@glint/template": "^1.7.7",
    "@glint/tsserver-plugin": "^2.7.17",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.10",
    "@types/rsvp": "^4.0.9",
    "babel-plugin-ember-template-compilation": "^3.1.0",
    "concurrently": "^8.2.2",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~6.12.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-deprecation-workflow": "^3.4.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.1.0",
    "ember-qunit": "^9.2.1",
    "ember-resolver": "^13.2.0",
    "ember-source": "~6.12.1",
    "ember-template-lint": "^7.9.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^16.5.0",
    "prettier": "^3.3.3",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.22.0",
    "qunit-dom": "^3.2.1",
    "sass": "^1.104.0",
    "testem": "^3.21.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "ember-prototype-inspector": "workspace:*",
    "@glimmer/tracking": "^1.1.2"
  },
  "dependencies": {
    "@hashicorp/design-system-components": "^7.1.0",
    "@hashicorp/design-system-tokens": "^6.0.1",
    "@hashicorp/flight-icons": "^5.3.0",
    "ember-basic-dropdown": "^8.9.0",
    "ember-intl": "^8.0.0"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "ember": {
    "edition": "octane"
  }
}
